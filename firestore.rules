rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'yukendranyukendran475@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Donor profiles
    match /donors/{donorId} {
      allow read: if isSignedIn();
      allow create: if isOwner(donorId) || isAdmin();
      allow update: if isOwner(donorId) || isAdmin();
      allow delete: if isOwner(donorId) || isAdmin();
    }

    // Hospital facilities
    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow create: if isOwner(hospitalId) || isAdmin();
      allow update: if isOwner(hospitalId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Blood Requests
    match /bloodRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Match Dispatches
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Donations
    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Hospital Blood Inventory
    match /inventory/{inventoryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Inventory Transaction History
    match /inventoryTransactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // immutable transaction records
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Regulatory & Operational Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // immutable audit log
    }
  }
}
